rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }

    // profiles: anyone signed in can read (leaderboard, opponent names); only you can write yours
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if me(uid) && request.resource.data.rating == 1200 && request.resource.data.games == 0;
      allow update: if me(uid);

      match /history/{id} {
        allow read, write: if me(uid);
      }
    }

    // online games / rooms
    match /games/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.players && (
        (request.resource.data.creator == request.auth.uid && request.resource.data.status == 'waiting') ||
        request.resource.data.status == 'active'   // quick-match pairing creates the game for both players
      );
      // players can update; a stranger may only fill the empty seat of a waiting room
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players ||
        (resource.data.status == 'waiting' && request.auth.uid in request.resource.data.players)
      );
      allow delete: if signedIn() && resource.data.creator == request.auth.uid && resource.data.status == 'waiting';
    }

    // quick-match queue: write your own entry; the pairing player may only set `matched` on someone else's
    match /queue/{uid} {
      allow read: if signedIn();
      allow create, delete: if me(uid);
      allow update: if me(uid) || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matched']));
    }
  }
}
