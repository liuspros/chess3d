rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }

    // profiles: anyone signed in can read (leaderboard, opponent names); only you can write yours
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if me(uid) && request.resource.data.rating == 1200 && request.resource.data.games == 0;
      allow update: if me(uid);

      // friends list: you manage yours; the person you accept may add themselves only while their request exists
      match /friends/{fid} {
        allow read: if me(uid);
        allow write: if me(uid);
        allow create: if signedIn() && request.auth.uid == fid && exists(/databases/$(database)/documents/requests/$(request.auth.uid + '_' + uid));
      }

      // push tokens: only you; the Vercel API reads them with the Admin SDK
      match /tokens/{t} {
        allow read, write: if me(uid);
      }

      match /history/{id} {
        allow read, write: if me(uid);
      }

      // purchases: readable by the owner, written ONLY by the Vercel API (Admin SDK bypasses rules)
      match /inventory/{id} {
        allow read: if me(uid);
        allow write: if false;
      }
    }

    // friend requests: id is `${to}_${from}`; the receiver reads/deletes, the sender creates
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from.uid == request.auth.uid && id == request.resource.data.to + '_' + request.auth.uid;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from.uid == request.auth.uid);
    }

    // direct challenges: one doc per recipient
    match /challenges/{toUid} {
      allow read: if signedIn() && (toUid == request.auth.uid || resource.data.from.uid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.from.uid == request.auth.uid;
      allow delete: if signedIn() && (toUid == request.auth.uid || resource.data.from.uid == request.auth.uid);
    }

    // orders are server-only (no client access)
    match /orders/{id} { allow read, write: if false; }

    // online games / rooms
    match /games/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.players && (
        (request.resource.data.creator == request.auth.uid && request.resource.data.status == 'waiting') ||
        request.resource.data.status == 'active'   // quick-match pairing creates the game for both players
      );
      // players can update; a stranger may only fill the empty seat of a waiting room
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players ||
        (resource.data.status == 'waiting' && request.auth.uid in request.resource.data.players)
      );
      allow delete: if signedIn() && resource.data.creator == request.auth.uid && resource.data.status == 'waiting';

      // in-game chat: anyone signed in may read (spectators), only the two players may write
      match /chat/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/games/$(code)).data.players
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200;
        allow delete: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/games/$(code)).data.players;
      }
    }

    // quick-match queue: write your own entry; the pairing player may only set `matched` on someone else's
    match /queue/{uid} {
      allow read: if signedIn();
      allow create, delete: if me(uid);
      allow update: if me(uid) || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matched']));
    }
  }
}
